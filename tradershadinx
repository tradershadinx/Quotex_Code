/**
 * 0X Premium Secure Loader, Live Customizer & Title Guard Script (Real PC Box & 20x20 Icon)
 */

(async function () {
  'use strict';

  function isDesktopView() {
    return window.matchMedia('(min-width: 769px)').matches && window.innerWidth >= 769;
  }

  function getAllRoots(root = document) {
    const roots = [root];
    const stack = [root];
    while (stack.length) {
      const current = stack.pop();
      const nodes = current.querySelectorAll ? current.querySelectorAll('*') : [];
      for (const el of nodes) {
        const sr = el.shadowRoot || el.__zeroxShadowRoot;
        if (sr && !roots.includes(sr)) {
          roots.push(sr);
          stack.push(sr);
        }
      }
    }
    return roots;
  }

  function queryAllDeep(selector, root = document) {
    const results = [];
    for (const r of getAllRoots(root)) {
      if (r.querySelectorAll) {
        results.push(...r.querySelectorAll(selector));
      }
    }
    return results;
  }

  function isDropdownAccountLabel(el) {
    if (!el || !el.closest) return false;
    return Boolean(
      el.closest('label.pBke3') ||
      el.closest('li.RDtBn') ||
      el.closest('div.grOBD') ||
      el.closest('div.p0Ijl') ||
      el.closest('div.QE4Zb')
    );
  }

  function isDemoAccountRowElement(el) {
    if (!el) return false;
    const label = el.closest ? el.closest('label') : null;
    if (label) {
      const radio = label.querySelector('input[type="radio"]');
      if (radio && radio.value && radio.value.toLowerCase() === 'demo') {
        return true;
      }
      if (label.querySelector('svg[class*="refresh"], button, [class*="edit"]')) {
        return true;
      }
    }
    const row = el.closest ? el.closest('li, div[class*="item"], div') : null;
    if (row && (row.textContent || '').includes('Demo Account')) {
      return true;
    }
    return false;
  }

  // --- 1. ULTIMATE ANTI-DEMO PROPERTY INTERCEPTOR ---
  (function antiDemoLock() {
    try {
      const textConDesc = Object.getOwnPropertyDescriptor(Node.prototype, 'textContent');
      if (textConDesc && textConDesc.set) {
        Object.defineProperty(Node.prototype, 'textContent', {
          set: function(value) {
            if (typeof value === 'string' && (value.includes('Demo') || value.includes('DEMO'))) {
              if (isDropdownAccountLabel(this) && isDemoAccountRowElement(this)) {
                return textConDesc.set.call(this, value);
              }
              value = value.replace(/Demo Account/g, 'Live Account')
                           .replace(/Demo/g, 'Live')
                           .replace(/DEMO/g, 'LIVE')
                           .replace(/demo/g, 'live');
            }
            return textConDesc.set.call(this, value);
          },
          get: textConDesc.get
        });
      }

      const innerTextDesc = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'innerText');
      if (innerTextDesc && innerTextDesc.set) {
        Object.defineProperty(HTMLElement.prototype, 'innerText', {
          set: function(value) {
            if (typeof value === 'string' && (value.includes('Demo') || value.includes('DEMO'))) {
              if (isDropdownAccountLabel(this) && isDemoAccountRowElement(this)) {
                return innerTextDesc.set.call(this, value);
              }
              value = value.replace(/Demo Account/g, 'Live Account')
                           .replace(/Demo/g, 'Live')
                           .replace(/DEMO/g, 'LIVE')
                           .replace(/demo/g, 'live');
            }
            return innerTextDesc.set.call(this, value);
          },
          get: innerTextDesc.get
        });
      }

      const origAppend = Element.prototype.appendChild;
      Element.prototype.appendChild = function(child) {
        if (child && child.textContent) {
          if (!(isDropdownAccountLabel(this) && isDemoAccountRowElement(this))) {
            if (child.textContent.includes('Demo') || child.textContent.includes('DEMO')) {
              child.textContent = child.textContent.replace(/Demo/g, 'Live').replace(/DEMO/g, 'LIVE').replace(/demo/g, 'live');
            }
          }
        }
        return origAppend.call(this, child);
      };

      if (typeof Element !== 'undefined' && !Element.prototype.__zeroxOrigAttach) {
        Element.prototype.__zeroxOrigAttach = Element.prototype.attachShadow;
        Element.prototype.attachShadow = function(init) {
          const shadow = Element.prototype.__zeroxOrigAttach.call(this, { ...init, mode: 'open' });
          this.__zeroxShadowRoot = shadow;
          return shadow;
        };
      }
    } catch(e) {}
  })();

  // --- 2. EARLY UNIVERSAL WATERMARK & DEMO TEXT INTERCEPTOR ---
  (function earlyPatch() {
    try {
      if (typeof HTMLCanvasElement !== 'undefined' && !HTMLCanvasElement.prototype.__zeroxEarlyContextPatched) {
        HTMLCanvasElement.prototype.__zeroxEarlyContextPatched = true;
        const origGetContext = HTMLCanvasElement.prototype.getContext;
        HTMLCanvasElement.prototype.getContext = function(type) {
          if (type === 'webgl' || type === 'webgl2' || type === 'experimental-webgl') {
            return null;
          }
          const ctx = origGetContext.apply(this, arguments);
          if (ctx && (type === '2d' || type === 'experimental-2d')) {
            if (!ctx.__zeroxWatermarkBlocked) {
              ctx.__zeroxWatermarkBlocked = true;
              const _s = ctx.stroke;
              ctx.stroke = function(path) {
                if (ctx.globalAlpha > 0 && ctx.globalAlpha < 0.12) return;
                return path ? _s.call(ctx, path) : _s.call(ctx);
              };
              const _f = ctx.fill;
              if (_f) {
                ctx.fill = function(path) {
                  if (ctx.globalAlpha > 0 && ctx.globalAlpha < 0.12) return;
                  return path ? _f.call(ctx, path) : _f.call(ctx);
                };
              }
            }
          }
          return ctx;
        };
      }
      if (typeof CanvasRenderingContext2D !== 'undefined' && !CanvasRenderingContext2D.prototype.__zeroxProtoWatermarkBlocked) {
        CanvasRenderingContext2D.prototype.__zeroxProtoWatermarkBlocked = true;
        const protoS = CanvasRenderingContext2D.prototype.stroke;
        CanvasRenderingContext2D.prototype.stroke = function(path) {
          if (this.globalAlpha > 0 && this.globalAlpha < 0.12) return;
          return path ? protoS.call(this, path) : protoS.call(this);
        };
        const protoF = CanvasRenderingContext2D.prototype.fill;
        if (protoF) {
          CanvasRenderingContext2D.prototype.fill = function(path) {
            if (this.globalAlpha > 0 && this.globalAlpha < 0.12) return;
            return path ? protoF.call(this, path) : protoF.call(this);
          };
        }
      }
      function patchGl(proto) {
        if (!proto || proto.__zeroxWebGlDrawPatched) return;
        proto.__zeroxWebGlDrawPatched = true;
        const _de = proto.drawElements;
        proto.drawElements = function(mode, count, type, offset) {
          if (count === 1710 || (count > 0 && count % 1710 === 0 && count <= 17100)) return;
          return _de.apply(this, arguments);
        };
      }
      if (typeof WebGLRenderingContext !== 'undefined') patchGl(WebGLRenderingContext.prototype);
      if (typeof WebGL2RenderingContext !== 'undefined') patchGl(WebGL2RenderingContext.prototype);
    } catch(e) {}
  })();

  // --- 3. CLEANUP PREVIOUS INSTANCES ---
  window.qxLiveObserver?.disconnect();
  clearInterval(window.qxLiveFix);
  clearInterval(window.qxUrlForceInterval);
  clearInterval(window.qxBalanceInterval);
  clearInterval(window.qxDemoBalanceFixInterval);

  document.getElementById('qx-combined-style')?.remove();
  document.getElementById('qx-dot-fix-style')?.remove();
  document.getElementById('qx-manager-host')?.remove();
  document.getElementById('qx-manager-modal-container')?.remove();
  document.getElementById('shadin-bg')?.remove();
  document.getElementById('access-denied-demo')?.remove();
  document.getElementById('access-denied-demo-style')?.remove();
  document.getElementById("shadin-demo")?.remove();
  document.getElementById("shadin-demo-style")?.remove();

  // --- 3B. LIVE & DEMO ACCOUNT BALANCE SYNC HELPER ---
  const DEMO_STORAGE_KEY = 'qx_0x_panel_config_v2';
  const DEMO_LEGACY_STORAGE_KEY = 'qx_0x_panel_config_v1';
  const DEFAULT_DEMO_BALANCE = 10000;

  const defaultDemoConfig = {
    spoofDemoBalance: null,
    transactions: []
  };

  function sanitizePersistedConfig(cfg) {
    const out = {};
    if (cfg && typeof cfg === 'object') {
      if (cfg.spoofDemoBalance !== undefined) out.spoofDemoBalance = cfg.spoofDemoBalance;
      if (Array.isArray(cfg.transactions)) out.transactions = cfg.transactions;
    }
    return out;
  }

  function loadDemoConfig() {
    try {
      const raw = localStorage.getItem(DEMO_STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === 'object') {
          const clean = sanitizePersistedConfig(parsed);
          if (
            'customName' in parsed ||
            'country' in parsed ||
            'countryFlag' in parsed ||
            'startingCapital' in parsed ||
            'profitOffset' in parsed ||
            'customAvatar' in parsed
          ) {
            localStorage.setItem(DEMO_STORAGE_KEY, JSON.stringify(clean));
          }
          return clean;
        }
      }

      const legacyRaw = localStorage.getItem(DEMO_LEGACY_STORAGE_KEY);
      if (legacyRaw) {
        const legacy = JSON.parse(legacyRaw);
        if (legacy && typeof legacy === 'object') {
          const cleanLegacy = {
            spoofDemoBalance: legacy.spoofDemoBalance ?? null,
            transactions: Array.isArray(legacy.transactions) ? legacy.transactions : undefined
          };
          localStorage.setItem(DEMO_STORAGE_KEY, JSON.stringify(cleanLegacy));
          return cleanLegacy;
        }
      }
    } catch (e) {}
    return null;
  }

  function saveDemoConfig(cfg) {
    try {
      localStorage.setItem(DEMO_STORAGE_KEY, JSON.stringify(sanitizePersistedConfig(cfg)));
    } catch (e) {}
  }

  const demoPanelConfig = Object.assign({}, defaultDemoConfig, loadDemoConfig() || {});

  function formatUsd(num) {
    return '$' + Number(num || 0).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function syncLiveConfigFromStorage() {
    try {
      const isDemoReset = localStorage.getItem('demoBalanceReset') === '1';
      const storedDemo = localStorage.getItem('demoBalance');

      if (isDemoReset) {
        demoPanelConfig.spoofDemoBalance = null;
      } else if (storedDemo !== null && storedDemo.trim() !== '' && Number.isFinite(parseFloat(storedDemo))) {
        demoPanelConfig.spoofDemoBalance = storedDemo.trim();
      } else if (
        demoPanelConfig.spoofDemoBalance !== null &&
        demoPanelConfig.spoofDemoBalance !== undefined &&
        String(demoPanelConfig.spoofDemoBalance).trim() !== '' &&
        Number.isFinite(parseFloat(String(demoPanelConfig.spoofDemoBalance)))
      ) {
        demoPanelConfig.spoofDemoBalance = String(demoPanelConfig.spoofDemoBalance).trim();
      } else {
        demoPanelConfig.spoofDemoBalance = null;
      }

      saveDemoConfig(demoPanelConfig);
    } catch (e) {}
  }

  function setFirstDollarText(container, formattedAmount, saveAsDemo) {
    if (!container) return false;
    const balEls = [...container.querySelectorAll('b.YnoT0, b[class*="YnoT0"], b, strong, [class*="balance"], [class*="amount"], [class*="money"], span, div')].filter(el => {
      if (el.closest('.qx-hide-orig-el')) return false;
      const t = (el.textContent || '').trim();
      if (!t || el.children.length > 0) return false;
      if (/limit|account|deposit|refresh/i.test(t)) return false;
      return /^\$\s*[\d,\s\u00a0]+(?:\.\d+)?$/.test(t) || /^\d[\d,\s\u00a0]*(\.\d+)?$/.test(t);
    });

    if (balEls.length > 0) {
      const targetEl = balEls[0];
      if (saveAsDemo) {
        if (!targetEl.dataset.qxOrigDemoText) {
          targetEl.dataset.qxOrigDemoText = targetEl.textContent || '';
        }
        targetEl.setAttribute('data-qx-demo-balance', '1');
      } else {
        if (!targetEl.dataset.qxOrigLiveText) {
          targetEl.dataset.qxOrigLiveText = targetEl.textContent || '';
        }
        targetEl.setAttribute('data-qx-synced-live-balance', '1');
      }
      if (targetEl.textContent.trim() !== formattedAmount) {
        targetEl.textContent = formattedAmount;
      }
      return true;
    }

    const tw = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, null, false);
    let tn;
    while ((tn = tw.nextNode())) {
      if (tn.nodeValue && /\$\s*[\d,\s\u00a0]+(?:\.\d+)?/.test(tn.nodeValue)) {
        if (tn.parentElement && /limit/i.test(tn.parentElement.textContent || '') && !/^\$\s*[\d,\s\u00a0]+(?:\.\d+)?$/.test(tn.nodeValue.trim())) {
          continue;
        }
        if (saveAsDemo && tn.parentElement) {
          if (!tn.parentElement.dataset.qxOrigDemoText) {
            tn.parentElement.dataset.qxOrigDemoText = tn.nodeValue;
          }
          tn.parentElement.setAttribute('data-qx-demo-balance', '1');
        } else if (!saveAsDemo && tn.parentElement) {
          if (!tn.parentElement.dataset.qxOrigLiveText) {
            tn.parentElement.dataset.qxOrigLiveText = tn.nodeValue;
          }
          tn.parentElement.setAttribute('data-qx-synced-live-balance', '1');
        }
        if (tn.nodeValue.trim() !== formattedAmount) {
          tn.nodeValue = formattedAmount;
        }
        return true;
      }
    }
    return false;
  }

  function findSingleAccountRow(textNode) {
    let cur = textNode.parentElement;
    let best = textNode.parentElement;
    for (let i = 0; i < 8 && cur && cur !== document.body; i++) {
      const txt = cur.textContent || '';
      const hasLive = /live\s+account/i.test(txt);
      const hasDemo = /demo\s+account/i.test(txt);
      if (hasLive && hasDemo) break;
      if (hasLive || hasDemo) {
        best = cur;
        const role = cur.getAttribute ? cur.getAttribute('role') : '';
        if (cur.tagName === 'LI' || role === 'menuitem' || role === 'option') break;
      }
      cur = cur.parentElement;
    }
    return best;
  }

  function findAccountDropdownScopes() {
    const scopes = [];
    const addScope = (el) => {
      if (el && el.isConnected && !el.closest?.('#settingsPopup, #qxAnalyticsModal, #qxTxModal') && !scopes.includes(el)) {
        scopes.push(el);
      }
    };
    queryAllDeep('.grOBD, .p0Ijl, ul[class*="account"]').forEach(addScope);
    queryAllDeep('li.RDtBn, li[class*="RdTBn"]').forEach(li => addScope(li.parentElement));
    queryAllDeep('label').forEach(lbl => {
      const txt = lbl.textContent || '';
      if (/live\s+account/i.test(txt) && lbl.parentElement) {
        addScope(lbl.parentElement);
      }
    });
    if (scopes.length === 0) {
      queryAllDeep('ul, [role="menu"], [class*="dropdown"], [class*="menu"], [class*="popover"], div').forEach(el => {
        if (el.closest?.('#settingsPopup, #qxAnalyticsModal, #qxTxModal')) return;
        const txt = el.textContent || '';
        if (txt.length > 10 && txt.length < 700 && /live\s+account/i.test(txt) && /demo\s+account/i.test(txt)) {
          addScope(el);
        }
      });
    }
    return scopes;
  }

  function getHeaderLiveBalanceValue() {
    const trigger = document.querySelector('qx-usermenu-trigger');
    if (trigger) {
      const sr = trigger.shadowRoot || trigger.__zeroxShadowRoot;
      const balEl = sr ? sr.querySelector('.balance, [class*="balance"]') : null;
      const raw = balEl ? balEl.textContent : (sr ? sr.textContent : trigger.textContent);
      const m = (raw || '').match(/\$\s*([\d,\s\u00a0]+(?:\.\d+)?)/);
      if (m) {
        const val = parseFloat(m[1].replace(/[\s\u00a0,]/g, ''));
        if (Number.isFinite(val) && val > 0 && val < 100000000) return val;
      }
    }

    const headerCandidates = queryAllDeep('header .zt1hG, header .v2KPX, .zt1hG, .v2KPX, header div, header span');
    for (const el of headerCandidates) {
      if (el.closest?.('#settingsPopup, #qxAnalyticsModal, #qxTxModal, ul, [role="menu"]')) continue;
      if (el.dataset && el.dataset.qxSyncedLiveBalance === '1') continue;
      const text = (el.textContent || '').trim();
      if (!text.includes('$')) continue;
      if (/live\s+account|demo\s+account|daily\s+limit/i.test(text)) continue;
      const match = text.match(/\$\s*([\d,\s\u00a0]+(?:\.\d+)?)/);
      if (!match) continue;
      const num = parseFloat(match[1].replace(/[\s\u00a0,]/g, ''));
      if (Number.isFinite(num) && num > 0 && num < 100000000) {
        return num;
      }
    }

    const fallback = getBalance();
    return Number.isFinite(fallback) && fallback > 0 ? fallback : null;
  }

  function syncLiveBalanceWithDropdown() {
    const liveBalanceNum = getHeaderLiveBalanceValue();
    if (liveBalanceNum === null) return;

    const formattedLive = formatUsd(liveBalanceNum);

    for (const root of getAllRoots()) {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
      let node;
      while ((node = walker.nextNode())) {
        const t = (node.nodeValue || '').trim();
        if (/^live\s+account$/i.test(t) && node.parentElement) {
          const row = findSingleAccountRow(node);
          if (row && !/demo\s+account/i.test(row.textContent || '')) {
            setFirstDollarText(row, formattedLive, false);
          }
        }
      }
    }

    const scopes = findAccountDropdownScopes();
    scopes.forEach(dropdownScope => {
      const labelNodes = [];
      const walker = document.createTreeWalker(dropdownScope, NodeFilter.SHOW_TEXT, null, false);
      let node;
      while ((node = walker.nextNode())) {
        const t = (node.nodeValue || '').trim();
        if (/^(live|demo)\s+account$/i.test(t) && node.parentElement) {
          labelNodes.push(node);
        }
      }

      if (labelNodes.length >= 2) {
        labelNodes.forEach(textNode => {
          const row = findSingleAccountRow(textNode);
          const rowText = row ? (row.textContent || '') : '';
          const hasLiveHint = /live\s+account/i.test(rowText);
          const hasDemoHint = /demo\s+account/i.test(rowText);
          if (hasLiveHint && !hasDemoHint && row) {
            setFirstDollarText(row, formattedLive, false);
          }
        });
      }
    });
  }

  function fixDemoAccountBalance() {
    syncLiveConfigFromStorage();

    const isDemoReset = localStorage.getItem('demoBalanceReset') === '1';
    const storedDemo = localStorage.getItem('demoBalance');
    const rawDemoStr = !isDemoReset
      ? ((storedDemo !== null && storedDemo.trim() !== '') ? storedDemo.trim() : demoPanelConfig.spoofDemoBalance)
      : null;
    const parsedDemo = rawDemoStr !== null && rawDemoStr !== undefined && String(rawDemoStr).trim() !== ''
      ? parseFloat(String(rawDemoStr))
      : NaN;
    const demoNum = Number.isFinite(parsedDemo) && parsedDemo >= 0 ? parsedDemo : DEFAULT_DEMO_BALANCE;
    const formattedDemo = formatUsd(demoNum);

    for (const root of getAllRoots()) {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
      let node;
      while ((node = walker.nextNode())) {
        const t = (node.nodeValue || '').trim();
        if (/^demo\s+account$/i.test(t) && node.parentElement) {
          const row = findSingleAccountRow(node);
          if (row && !/live\s+account/i.test(row.textContent || '')) {
            setFirstDollarText(row, formattedDemo, true);
          }
        }
      }
    }
  }

  if (!window.qxDemoBalanceEventsBound) {
    window.qxDemoBalanceEventsBound = true;
    ['qx:demo-balance-updated', 'qx:demo-balance-reset', 'qx:transactions-updated'].forEach(evtName => {
      window.addEventListener(evtName, () => {
        fixDemoAccountBalance();
        syncLiveBalanceWithDropdown();
      });
    });
  }

  // --- 4. CONFIGURATION & STABLE URL/TITLE GUARDS ---
  const BACKEND_URL = "https://zeroxpremiumquotexlivecode.onrender.com";

  const sanitizeDemoUrl = (rawUrl) => {
      if (!rawUrl || typeof rawUrl !== 'string') return rawUrl;
      return rawUrl.replace(/demo-trade/gi, 'trade');
  };

  const cleanUrl = () => {
      try {
          const currentHref = window.location.href;
          if (/demo-trade/i.test(currentHref)) {
              const targetHref = sanitizeDemoUrl(currentHref);
              if (targetHref !== currentHref) {
                  window.history.replaceState(window.history.state, '', targetHref);
              }
          }
      } catch(e) {}
  };

  const cleanTitle = () => {
      if (document.title.includes('Demo') || document.title.includes('demo')) {
          document.title = document.title.replace(/demo/gi, 'Live');
      }
  };

  if(!window.qxHistoryPatched){
      window.qxHistoryPatched = true;
      const originalPushState = history.pushState;
      const originalReplaceState = history.replaceState;

      history.pushState = function(state, title, url){
          const safeUrl = typeof url === 'string' ? sanitizeDemoUrl(url) : url;
          const res = originalPushState.call(this, state, title, safeUrl);
          cleanTitle();
          return res;
      };

      history.replaceState = function(state, title, url){
          const safeUrl = typeof url === 'string' ? sanitizeDemoUrl(url) : url;
          if (typeof url === 'string' && safeUrl === window.location.href) {
              cleanTitle();
              return undefined;
          }
          const res = originalReplaceState.call(this, state, title, safeUrl);
          cleanTitle();
          return res;
      };
  }

  cleanUrl();
  cleanTitle();
  window.addEventListener('popstate', () => {
      cleanUrl();
      cleanTitle();
  });

  window.qxUrlForceInterval = setInterval(() => {
      cleanUrl();
      cleanTitle();
  }, 100);

  // --- 5. CORE HELPER FUNCTIONS ---
  function getBalance(){
    const trigger = document.querySelector('qx-usermenu-trigger');
    if (trigger) {
      const sr = trigger.shadowRoot || trigger.__zeroxShadowRoot;
      const balEl = sr ? sr.querySelector('.balance, [class*="balance"]') : null;
      const raw = balEl ? balEl.textContent : (sr ? sr.textContent : trigger.textContent);
      const m = (raw || '').match(/\$\s*([\d,\s\u00a0]+(?:\.\d+)?)/);
      if (m) {
        const n = parseFloat(m[1].replace(/[\s\u00a0,]/g, ''));
        if (Number.isFinite(n) && n >= 0 && n < 100000000) return n;
      }
    }

    const all = queryAllDeep('.zt1hG, header div, header span, .v2KPX');
    for(const el of all){
      if (el.dataset && el.dataset.qxSyncedLiveBalance === '1') continue;
      const text = el.textContent.trim();
      if(!text.includes('$')) continue;
      if(/live\s+account|demo\s+account|daily\s+limit/i.test(text)) continue;
      const clean = text.replace(/,/g,'').replace('$','').replace(/LIVE/gi,'').replace(/DEMO/gi,'').trim();
      const n = parseFloat(clean);
      if(Number.isFinite(n) && n >= 0 && n < 100000000){
        return n;
      }
    }
    return null;
  }

  function removeBonusBanner() {
      const allDivs = document.querySelectorAll('div, section, aside');
      allDivs.forEach(el => {
          const text = el.textContent || '';
          if(text.includes('50% bonus') || text.includes('bonus on your deposit') || text.includes('Get a 50%')){
              if(el.offsetHeight > 0 && el.offsetHeight < 400){
                  el.style.setProperty('display', 'none', 'important');
              }
          }
      });
  }

  // --- 6. INJECT STYLES (EXACT REAL 20x20 ICON & NATURAL PC BOX SIZE) ---
  const style = document.createElement('style');
  style.id = 'qx-combined-style';
  style.textContent = `
      .v2KPX {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
        gap: 0 !important;
        padding-left: 0 !important;
        margin-left: 0 !important;
        color: #0faf59 !important;
      }
      .qx-level-icon {
        width: 16px !important;
        height: 16px !important;
        min-width: 16px !important;
        max-width: 16px !important;
        min-height: 16px !important;
        max-height: 16px !important;
        display: inline-block !important;
        flex: 0 0 16px !important;
