          const outerRing = label.querySelector('.yJFvf');
          if (outerRing) {
              setIfDifferent(outerRing, 'width', '20px');
              setIfDifferent(outerRing, 'height', '20px');
              setIfDifferent(outerRing, 'border-color', '#cfd5de');
              setIfDifferent(outerRing, 'background-color', 'transparent');
              setIfDifferent(outerRing, 'opacity', '1');
              setIfDifferent(outerRing, 'visibility', 'visible');
